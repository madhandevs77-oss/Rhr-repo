# Copy to .env (never commit it). Nothing here is ever sent to the browser.
PORT=3001
# Required in production
DATABASE_URL=postgres://rhr:CHANGE_ME@localhost:5432/rhr
DB_POOL_MAX=10
# Neon: paste the connection string that ends in ?sslmode=require. Use the "pooled" host for DATABASE_URL
# and the DIRECT host (no "-pooler" in it) for MIGRATE_DATABASE_URL. Leave DATABASE_SSL empty to follow the URL.
MIGRATE_DATABASE_URL=
DATABASE_SSL=
# Amazon RDS: DATABASE_SSL_CA_FILE=/app/certs/rds-global-bundle.pem (present in the Docker image) turns on verified TLS.
DATABASE_SSL_CA_FILE=

# Behind HTTPS reverse proxy (nginx/Caddy): set TRUST_PROXY=true and keep COOKIE_SECURE=true
TRUST_PROXY=false
COOKIE_SECURE=true
SESSION_HOURS=12

# First admin, created on first start only when the users table is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Hall photo storage. local = files on disk (development / Docker volume). supabase = Supabase Storage (Render free).
# s3 = Amazon S3 (AWS): private bucket, credentials from the IAM task/instance role (no keys in this file).
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=hall-images
S3_BUCKET=
AWS_REGION=
# S3_ENDPOINT is only for S3-compatible stores or tests; leave empty on AWS.
S3_ENDPOINT=
# local driver only (put on a persistent volume and include in backups):
UPLOAD_DIR=./storage/uploads
BACKUP_DIR=./storage/backups
MAX_IMAGE_MB=8
MAX_IMAGES_PER_HALL=20
MIN_IMAGE_WIDTH=400
MIN_IMAGE_HEIGHT=300
MAX_IMAGE_DIMENSION=8000

# Customer messages. Leave blank to stay in test mode (nothing is sent).
NOTIFY_WORKER=true
NOTIFY_POLL_MS=5000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_WEBHOOK_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0

# Email (bills with the invoice PDF attached, thank-you notes). Any SMTP service works.
# Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your address, SMTP_PASS=an "App password" (needs 2-step verification on)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RHR Veg Restaurant <bookings@yourdomain.com>
SMTP_REPLY_TO=

# Optional future payment-gateway webhook (HMAC-SHA256 in X-Signature). Disabled when empty.
PAYMENT_WEBHOOK_SECRET=
