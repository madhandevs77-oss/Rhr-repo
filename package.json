{
  "name": "rhr-booking",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "server": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:all": "node scripts/dev-all.mjs",
    "migrate": "node server/scripts/migrate.js",
    "seed": "node server/scripts/seed.js",
    "create-admin": "node server/scripts/create-admin.js",
    "backup": "node server/scripts/backup.js",
    "restore": "node server/scripts/restore.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "start": "NODE_ENV=production node server/index.js",
    "upload-local-images": "node server/scripts/upload-local-images.js"
  },
  "dependencies": {
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "mailparser": "^3.12.4",
    "smtp-server": "^3.21.1",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22"
  }
}
